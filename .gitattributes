# Normalize line endings across platforms; mark generated artifacts
* text=auto eol=lf

# Binary artifacts that must never be modified by git
docs/og.png binary

# Generated by scripts/build.py — regenerated in CI, no conflict markers wanted
merge=ours

# Linguist: generated-by-tool files
docs/data/tree.json linguist-generated=true
tree/**/*.md linguist-generated=true
docs/sitemap.xml linguist-generated=true